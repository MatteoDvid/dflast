AMAZON_PAAPI_SECRET_ACCESS_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_PARTNER_TYPE=Associates
AMAZON_IMAGE_CACHE_TTL_HOURS=24
